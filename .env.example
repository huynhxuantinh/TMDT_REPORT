# Copy this file to .env and fill in your own local configuration.
# Generate SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-generated-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=ql_benhvien
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Adjust to the actual OSGeo4W installation and DLL names on your machine.
GDAL_PATH=C:/OSGeo4W/bin/gdal312.dll
GEOS_PATH=C:/OSGeo4W/bin/geos_c.dll

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PUBLIC_BASE_URL=

GOOGLE_MAPS_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@qlbenhvien.local
