# Copy this file to .env and fill in your own local configuration.
# Generate SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-generated-django-secret-key
# Debug is off unless explicitly enabled. Local development: set DEBUG=True.
# Any deployed instance must keep it off and list real hosts in ALLOWED_HOSTS.
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=ql_benhvien
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Adjust to the actual OSGeo4W installation and DLL names on your machine.
GDAL_PATH=C:/OSGeo4W/bin/gdal312.dll
GEOS_PATH=C:/OSGeo4W/bin/geos_c.dll

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PUBLIC_BASE_URL=
# Optional: transaction lookup endpoint used before closing a reconciliation.
# VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Optional: how long a late IPN is still awaited after het_han_luc (default 45).
# VNPAY_IPN_GRACE_MINUTES=45

GOOGLE_MAPS_API_KEY=
# Payment receipts allow only Mailtrap Email Testing SMTP, never Email Sending.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@qlbenhvien.local
